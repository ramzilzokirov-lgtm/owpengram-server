# VGRAM Private operator template.
# Do not deploy as-is: the issued-number whitelist and Telegram bot adapter must
# be implemented and configured before enabling public registration.

TELESRV_PUBLIC_APP_NAME=VGRAM Private
TELESRV_PUBLIC_APP_SCHEME=owpg
TELESRV_PUBLIC_DOWNLOAD_URL=https://github.com/ramzilzokirov-lgtm/owpengram-android-client/releases
TELESRV_PHONE_CODE_DELIVERY_PROVIDER=webhook
TELESRV_PHONE_CODE_LENGTH=6
VGRAM_BOT_TOKEN=REPLACE_WITH_TELEGRAM_BOT_TOKEN
VGRAM_BOT_HTTP_PORT=2801
TELESRV_PHONE_CODE_LENGTH=6
TELESRV_AUTH_CODE_TTL=5m
TELESRV_AUTH_CODE_MAX_ATTEMPTS=5

# Point this to the VGRAM bot delivery adapter after it is deployed.
TELESRV_OTP_WEBHOOK_URL=http://127.0.0.1:2801/v1/otp/deliveries
# Generate a long random secret and set the same value in the bot adapter.
TELESRV_OTP_WEBHOOK_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Required for a real deployment; set these in the deployment secret manager.
TELESRV_PUBLIC_BASE_URL=https://REPLACE_WITH_YOUR_DOMAIN
TELESRV_ADVERTISE_IP=REPLACE_WITH_PUBLIC_IP
TELESRV_POSTGRES_DSN=REPLACE_WITH_POSTGRES_DSN
TELESRV_REDIS_ADDR=REPLACE_WITH_REDIS_ADDRESS
